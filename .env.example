# ---------------------------------------------------------------------------
# BOYOMA CONNECT — variables d'environnement
# Copier en .env.local (jamais commité). Les variables NEXT_PUBLIC_* sont
# envoyées au navigateur : n'y mettez JAMAIS de clé secrète.
# ---------------------------------------------------------------------------

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valeurs publiques (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase — clé SECRÈTE, serveur uniquement (webhooks paiement, tâches admin).
# Ne jamais préfixer par NEXT_PUBLIC_. Laisser vide en développement.
SUPABASE_SECRET_KEY=

# Malipo — encaissement Mobile Money (M-Pesa, Orange Money, Airtel Money). Serveur uniquement.
# Voir MALIPO_INTEGRATION.md. Ne jamais mettre de vraie clé dans ce fichier.
# Mode : sandbox (clé sk_test_…) ou live (clé sk_live_… + MALIPO_LIVE_CONFIRMED=oui).
MALIPO_MODE=sandbox
MALIPO_API_BASE_URL=https://api.malipo.dev/v1
MALIPO_API_KEY=
# Secret de signature de l'endpoint webhook (64 caractères hexadécimaux, tableau de bord Malipo > Webhooks).
MALIPO_WEBHOOK_SECRET=
# Unité des montants envoyés à l'API : major (unité principale, vérifié en Sandbox : 3 USD → 3) ou minor.
MALIPO_AMOUNT_UNIT=major
# Garde-fou : doit valoir « oui » pour autoriser le mode live (paiements réels).
MALIPO_LIVE_CONFIRMED=
# Secret des tâches planifiées (rapprochement quotidien Vercel Cron), 32 caractères aléatoires ou plus.
CRON_SECRET=

# Cartographie (MapLibre). Style par défaut : OpenFreeMap (gratuit, sans clé,
# données © OpenStreetMap). Remplaçable par un fournisseur commercial.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routage (itinéraires tracés). Vide = repli vers une application de navigation externe.
# Exemple : instance OSRM auto-hébergée https://osrm.example.org
NEXT_PUBLIC_ROUTING_URL=
