# ---------------------------------------------------------------------------
# BOYOMA CONNECT — variables d'environnement
# Copier en .env.local (jamais commité). Les variables NEXT_PUBLIC_* sont
# envoyées au navigateur : n'y mettez JAMAIS de clé secrète.
# ---------------------------------------------------------------------------

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valeurs publiques (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase — clé SECRÈTE, serveur uniquement (webhooks paiement, tâches admin).
# Ne jamais préfixer par NEXT_PUBLIC_. Laisser vide en développement.
SUPABASE_SECRET_KEY=

# Cartographie (MapLibre). Style par défaut : OpenFreeMap (gratuit, sans clé,
# données © OpenStreetMap). Remplaçable par un fournisseur commercial.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routage (itinéraires tracés). Vide = repli vers une application de navigation externe.
# Exemple : instance OSRM auto-hébergée https://osrm.example.org
NEXT_PUBLIC_ROUTING_URL=
