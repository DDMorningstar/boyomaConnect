  "private": true,
  "description": "Boyoma Connect — Votre ville. Vos adresses. Votre chemin.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
